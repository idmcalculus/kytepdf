# Server
PORT=3000
HOST=127.0.0.1

# Database
# Use PostgreSQL in prod: postgresql://user:pass@host:5432/dbname
DATABASE_URL=./local.db

# Security & Sessions
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CSRF_COOKIE_SECURE=false
CSRF_COOKIE_SAMESITE=lax

# Application
BASE_URL=http://localhost:5173
# Include both localhost and 127.0.0.1 variants — Playwright and some local setups
# use 127.0.0.1 while browsers typically use localhost. Both must be allowed to
# avoid CORS preflight failures during development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000

# Email (Development: use 'console' or SMTP; Production: 'ses')
EMAIL_PROVIDER=console
# RESEND_API_KEY=
# SES_REGION=us-east-1
# SES_FROM_ADDRESS=noreply@kytepdf.com

# OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/auth/oauth/google/callback

# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://localhost:3000/auth/oauth/github/callback
