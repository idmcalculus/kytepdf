{
  "name": "kyte-pdf",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run sync:wasm && vite",
    "build": "bun run sync:wasm && tsc && vite build && bun run scripts/assert-worker-artifacts.ts",
    "preview": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "sync:wasm": "bun run scripts/sync-pdf-inspector-wasm.ts",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:assert": "bun run scripts/assert-coverage-report.ts",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "auth-server:install": "npm install --prefix auth-server",
    "auth-server:dev": "npm run dev --prefix auth-server",
    "auth-server:start": "npm run start --prefix auth-server"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-istanbul": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "sass": "^1.108.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@firecrawl/anydoc-wasm": "0.2.4",
    "@firecrawl/pdf-inspector-wasm": "1.26.0",
    "@fontsource/great-vibes": "^5.3.0",
    "docx": "^9.15.4",
    "jszip": "^3.10.2",
    "lucide": "^1.73.0",
    "pdf-lib-with-encrypt": "^1.2.1",
    "pdfjs-dist": "^6.5.438",
    "tesseract.js": "^7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,css,scss,md,yml,yaml}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
