{
  "name": "kyte-pdf",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run sync:wasm && vite",
    "build": "bun run sync:wasm && tsc && vite build && bun run scripts/assert-worker-artifacts.ts",
    "preview": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "sync:wasm": "bun run scripts/sync-pdf-inspector-wasm.ts",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:assert": "bun run scripts/assert-coverage-report.ts",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "auth-server:install": "npm install --prefix auth-server",
    "auth-server:dev": "npm run dev --prefix auth-server",
    "auth-server:start": "npm run start --prefix auth-server"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@playwright/test": "^1.57.0",
    "@types/jsdom": "^27.0.0",
    "@types/jszip": "^3.4.1",
    "@types/node": "^25.0.3",
    "@types/pdfjs-dist": "^2.10.378",
    "@vitest/coverage-istanbul": "^4.0.16",
    "@vitest/coverage-v8": "^4.0.16",
    "esbuild": "^0.27.2",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.5.3",
    "husky": "^9.1.7",
    "jsdom": "^27.3.0",
    "lint-staged": "^17.0.5",
    "sass": "^1.97.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@firecrawl/anydoc-wasm": "0.1.8",
    "@firecrawl/pdf-inspector-wasm": "1.14.1",
    "@fontsource/great-vibes": "^5.2.8",
    "@pdf-lib/fontkit": "^1.1.1",
    "docx": "^9.5.1",
    "jszip": "^3.10.1",
    "lucide": "^0.562.0",
    "pdf-lib-with-encrypt": "^1.2.1",
    "pdfjs-dist": "^5.4.449",
    "tesseract.js": "^6",
    "xlsx": "^0.18.5"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,css}": [
      "biome check --write"
    ]
  }
}
