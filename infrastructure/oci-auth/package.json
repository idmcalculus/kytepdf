{
  "name": "oci-auth-hosting",
  "version": "0.1.0",
  "description": "Pulumi TypeScript project for OCI Always Free auth server hosting",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "npm run build && vitest run"
  },
  "lint-staged": {
    "**/*.{js,ts,json}": "npx biome check --write"
  },
  "dependencies": {
    "@pulumi/oci": "^5.7.0",
    "@pulumi/pulumi": "^3.276.0",
    "@pulumi/random": "^4.21.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "fast-check": "^4.10.2",
    "js-yaml": "^5.5.0",
    "lint-staged": "^17.6.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0"
  }
}
