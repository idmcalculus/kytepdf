{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM"],
    "types": ["node"]
  },
  "include": [
    "index.ts",
    "cloudinit.ts",
    "network.ts",
    "utils.ts",
    "validation.ts",
    "vm.ts",
    "parity/**/*.ts",
    "tests/**/*.ts"
  ]
}
